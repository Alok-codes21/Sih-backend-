# ═══════════════════════════════════════════════════════
#  ATHLETECONNECT — COMPLETE .env FILE (Phase 1-4)
#  Copy this file as .env and fill in real values
# ═══════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500

# ─── Authentication (Phase 1) ─────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRY=24

# ─── MongoDB (Phase 1) ────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/athleteconnect
MONGODB_DB_NAME=athleteconnect

# ─── Redis Cache (Phase 1 — Optional) ─────────────────
# If not set, in-memory cache fallback will be used
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting (Phase 1) ──────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── File Uploads & Cloudinary (Optional, falls back to ./uploads) ────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email / SMTP (Password Reset & Deadline Alerts) ──────────────────
# If SMTP_HOST/SMTP_USER/SMTP_PASS are not all set, email sending is
# skipped gracefully and the action (e.g. password reset) still succeeds.
# Gmail example (requires a Google Account App Password, not your normal
# password): myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="AthletIQ <your_email@gmail.com>"

# ─── Member 5 (AI Engineer) Python FastAPI Service Endpoint ─────────
PYTHON_AI_URL=http://localhost:8000

# ─── AI API Key (Fallback direct LLM if needed) ─────────────────────
GEMINI_API_KEY=your_google_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

